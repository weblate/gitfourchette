#: trtables.py:403
msgid "Show tab close button"
msgstr "Показывать кнопку закрытия вкладки"

#: trtables.py:404
msgid "Expand tabs to available width"
msgstr "Растягивать вкладки на доступную ширину"

#: trtables.py:405
msgid "Auto-hide tabs if only one repo is open"
msgstr "Автоматически скрывать вкладки, если открыт только один репозиторий"

#: trtables.py:407
msgid "Sort commits"
msgstr "Сортировка коммитов"

#: trtables.py:408
msgid "Chronologically"
msgstr "Хронологически"

#: trtables.py:409
msgid "Topologically"
msgstr "Топологически"

#: trtables.py:411
msgid "<b>Chronological mode</b> lets you stay on top of the latest activity in the repository. The most recent commits always show up at the top of the graph. However, the graph can get messy when multiple branches receive commits in the same timeframe."
msgstr "<b>Хронологический режим</b> позволяет быть в курсе последней активности в репозитории. Самые новые коммиты всегда отображаются вверху графа. Однако граф может усложниться, если несколько ветвей получают коммиты в одно и то же время."

#: trtables.py:414
msgid "<b>Topological mode</b> makes the graph easier to read. It attempts to present sequences of commits within a branch in a linear fashion. Since this is not a strictly chronological mode, you may have to do more scrolling to see the latest changes in various branches."
msgstr "<b>Топологический режим</b> делает граф более читаемым. Он старается представлять последовательности коммитов внутри ветви линейно. Поскольку это не строго хронологический режим, возможно, придётся больше прокручивать, чтобы увидеть последние изменения в разных ветвях."

#: trtables.py:418
msgid "Row spacing"
msgstr "Расстояние между строками"

#: trtables.py:419
msgid "Avoid gaps between branches in the graph"
msgstr "Избегать разрывов между ветвями на графе"

#: trtables.py:420
msgid "Mark author/committer signature differences"
msgstr "Отмечать различия подписей автора и коммиттера"

#: trtables.py:422
msgid "The commit history displays information about a commit’s <b>author</b>—their name and the date at which they made the commit. But in some cases, a commit might have been revised by someone else than the original author—this person is called the <b>committer</b>."
msgstr "История коммитов отображает сведения об <b>авторе</b> коммита — его имени и дате создания коммита. Но в некоторых случаях коммит может быть изменён кем-то другим, а не первоначальным автором — этот человек называется <b>коммиттером</b>."

#: trtables.py:426
msgid "If you tick this option, an asterisk (*) will appear after the author’s name and/or date if they differ from the committer’s for any given commit."
msgstr "Если отметить этот пункт, после имени и/или даты автора будет появляться звёздочка (*), если они отличаются от данных коммиттера для данного коммита."

#: trtables.py:428
msgid "Note that you can always hover over the author’s name or date to obtain detailed information about the author and the committer."
msgstr "Учтите, что всегда можно навести курсор на имя или дату автора, чтобы получить подробные сведения об авторе и коммиттере."

#: trtables.py:431
msgid "Load up to # commits in the history"
msgstr "Загружать до # коммитов в истории"

#: trtables.py:432
msgid "Set to 0 to always load the full commit history."
msgstr "Установите 0, чтобы всегда загружать полную историю коммитов."

#: trtables.py:433
msgid "Draw rows using alternating background colors"
msgstr "Рисовать строки с чередующимися цветами фона"

#: trtables.py:434
msgid "Ref indicators"
msgstr "Индикаторы ссылок"

#: trtables.py:435
msgid "You can always hover over an indicator to display the full name of the ref."
msgstr "Вы всегда можете навести курсор на индикатор, чтобы отобразить полное имя ссылки."

#: trtables.py:436
msgid "Verify signed commits on the fly"
msgstr "Проверять подписанные коммиты на лету"

#: trtables.py:438
#, python-brace-format
msgid "As commits scroll into view, call {0} automatically to verify their signatures. The verification status is materialized by a seal icon next to the author’s name:"
msgstr "Когда коммиты появляются в поле зрения, автоматически вызывать {0} для проверки их подписей. Статус проверки отображается значком печати рядом с именем автора:"

#: trtables.py:440
msgid "(No seal = Commit isn’t signed)"
msgstr "(Нет печати = коммит не подписан)"

#: trtables.py:442
msgid "The trash keeps up to # discarded patches"
msgstr "Корзина хранит до # отменённых патчей"

#: trtables.py:443
msgid "Patches bigger than # KB won’t be salvaged"
msgstr "Патчи больше # КБ не будут сохраняться"

#: trtables.py:445
#, python-brace-format
msgid "When you discard changes from the working directory, {app} keeps a temporary copy in a hidden “trash” folder. This gives you a last resort to rescue changes that you have discarded by mistake. You can look around this trash folder via <i>“Help &rarr; Open Trash”</i>."
msgstr "Когда вы отменяете изменения в рабочем каталоге, {app} сохраняет временную копию в скрытой папке «корзина». Это даёт последний шанс спасти изменения, отменённые по ошибке. Просмотреть содержимое корзины можно через <i>«Справка → Открыть корзину»</i>."

#: trtables.py:449
msgid "Logging verbosity"
msgstr "Подробность журнала"

#: trtables.py:450
msgid "Auto-refresh when app regains focus"
msgstr "Автообновление при возврате фокуса в приложение"

#: trtables.py:452
#, python-brace-format
msgid "When you return to {app} from another application, it automatically scans for changes in the working directory and local branches. This keeps the interface in sync with the state of your repo on disk."
msgstr "Когда вы возвращаетесь в {app} из другого приложения, оно автоматически сканирует изменения в рабочем каталоге и локальных ветвях. Это поддерживает синхронизацию интерфейса с состоянием репозитория на диске."

#: trtables.py:455
#, python-brace-format
msgid "If you turn this off, you will need to hit {key} to perform this refresh manually."
msgstr "Если выключить эту функцию, для ручного обновления потребуется нажать {key}."

#: trtables.py:457
msgid "We strongly recommend to keep this setting enabled."
msgstr "Настоятельно рекомендуется оставить этот параметр включённым."

#: trtables.py:458
msgid "Auto-fetch remotes every # minutes"
msgstr "Автоматически получать удалённые репозитории каждые # минут"

#: trtables.py:459
msgid "Animation effects in sidebar"
msgstr "Анимационные эффекты в боковой панели"

#: trtables.py:460
msgid "Smooth scrolling (where applicable)"
msgstr "Плавная прокрутка (где применимо)"

#: trtables.py:461
msgid "Preferred Qt binding"
msgstr "Предпочитаемая привязка Qt"

#: trtables.py:463
#, python-brace-format
msgid "After restarting, {app} will use this Qt binding if available."
msgstr "После перезапуска {app} будет использовать эту привязку Qt, если она доступна."

#: trtables.py:464
msgid "You can also pass the name of a Qt binding via the “QT_API” environment variable."
msgstr "Также можно указать имя привязки Qt через переменную окружения «QT_API»."

#: trtables.py:466
msgid "Use condensed fonts"
msgstr "Использовать сжатые шрифты"

#: trtables.py:468
msgid "When a branch name or author name is too long to fit in its allotted space, condense the font before truncating the text."
msgstr "Когда имя ветви или автора слишком длинное и не помещается в отведённое место, сжимать шрифт, прежде чем обрезать текст."

#: trtables.py:471
msgid "Text editor"
msgstr "Текстовый редактор"

#: trtables.py:474 trtables.py:480 trtables.py:488
msgid "Argument placeholders:"
msgstr "Заполнители аргументов:"

#: trtables.py:475
msgid "Old / Left"
msgstr "Старый / левый"

#: trtables.py:476
msgid "New / Right"
msgstr "Новый / правый"

#: trtables.py:481
msgid "Ancestor / Base / Center"
msgstr "Предок / база / центр"

#: trtables.py:482
msgid "Ours / Local / Left"
msgstr "Наш / локальный / левый"

#: trtables.py:483
msgid "Theirs / Remote / Right"
msgstr "Их / удалённый / правый"

#: trtables.py:484
msgid "Merged / Output / Result"
msgstr "Слитый / вывод / результат"

#: trtables.py:489
msgid "Command to execute after launching the terminal"
msgstr "Команда для выполнения после запуска терминала"

#: trtables.py:490
#, python-brace-format
msgid "The {0} placeholder is mandatory. It is automatically substituted for a wrapper script that enters your working directory and optionally starts one of your Custom Commands."
msgstr "Заполнитель {0} обязателен. Он автоматически подставляется как скрипт-обёртка, который переходит в ваш рабочий каталог и при необходимости запускает одну из ваших пользовательских команд."

#: trtables.py:494
#, python-brace-format
msgid "Have OpenSSH ask for passphrases via {app}"
msgstr "Запрашивать парольные фразы в OpenSSH через {app}"

#: trtables.py:496
#, python-brace-format
msgid "Tick this to have OpenSSH use {app} to ask for passphrases."
msgstr "Отметьте, чтобы OpenSSH использовал {app} для запроса парольных фраз."

#: trtables.py:497
#, python-brace-format
msgid "Untick this if you’ve set up another program in the {0} environment variable (such as {1})."
msgstr "Снимите отметку, если вы настроили другую программу в переменной окружения {0} (например, {1})."

#: trtables.py:499
msgid "(not detected)"
msgstr "(не обнаружен)"

#: trtables.py:499
msgid "Use ssh-agent provided by the system"
msgstr "Использовать агент SSH, предоставляемый системой"

#: trtables.py:500
#, python-brace-format
msgid "Have {app} manage its own ssh-agent"
msgstr "Разрешить {app} управлять собственным агентом SSH"

#: trtables.py:502
msgid "“ssh-agent” can save your SSH credentials so you don’t have to retype the same passphrase over and over. Some Linux distributions set up an ssh-agent for you."
msgstr "«ssh-agent» может сохранять ваши учётные данные SSH, чтобы не вводить одну и ту же парольную фразу снова и снова. Некоторые дистрибутивы Linux настраивают агент SSH за вас."

#: trtables.py:504
#, python-brace-format
msgid "You can also have {app} start its own instance of ssh-agent for the duration of your session and have it remember passphrases."
msgstr "Также можно разрешить {app} запускать собственный экземпляр ssh-agent на время сеанса, чтобы он запоминал парольные фразы."

#: trtables.py:508
msgid "Parse LFS pointers"
msgstr "Разбирать указатели LFS"

#: trtables.py:510
msgid "Tick this to display the real contents from LFS files."
msgstr "Отметьте, чтобы отображать реальное содержимое файлов LFS."

#: trtables.py:511
msgid "Untick to display the raw text in LFS pointers."
msgstr "Снимите отметку, чтобы отображать исходный текст указателей LFS."

#: trtables.py:514
msgid "Mouse Shortcuts"
msgstr "Мышиные комбинации"

#: trtables.py:515
msgid "Tip: If your mouse has side buttons, you can use them to navigate back/forward in the repo."
msgstr "Совет: если у мыши есть боковые кнопки, их можно использовать для навигации назад/вперёд по репозиторию."

#: trtables.py:516
msgid "Repository tabs:"
msgstr "Вкладки репозиториев:"

#: trtables.py:517
msgid "Double-click tab"
msgstr "Двойной щелчок по вкладке"

#: trtables.py:518
msgid "Middle-click tab"
msgstr "Щелчок средней кнопкой по вкладке"

#: trtables.py:519
msgid "File lists:"
msgstr "Списки файлов:"

#: trtables.py:520
msgid "Double-click file"
msgstr "Двойной щелчок по файлу"

#: trtables.py:521
msgid "Middle-click file"
msgstr "Щелчок средней кнопкой по файлу"

#: trtables.py:522
msgid "Diff view:"
msgstr "Просмотр сравнения:"

#: trtables.py:523
msgid "Middle-click selection"
msgstr "Щелчок средней кнопкой по выделению"

#: trtables.py:524
msgid "Stage/unstage selected lines"
msgstr "Подготовить/убрать выбранные строки"

#: trtables.py:529
msgid "Ask for confirmation before running any command"
msgstr "Запрашивать подтверждение перед выполнением любой команды"

#: trtables.py:531
#, python-brace-format
msgid "If you untick this, you can still force a prompt to appear for specific commands by prepending them with {0}. For example: {1}"
msgstr "Если снять отметку, всё равно можно принудительно вызвать запрос для конкретных команд, добавив перед ними {0}. Например: {1}"

#: trtables.py:559
msgctxt "date/time formats"
msgid "Available formats:"
msgstr "Доступные форматы:"

#: trtables.py:561 trtables.py:562
msgid "year"
msgstr "год"

#: trtables.py:564 trtables.py:565
msgid "month"
msgstr "месяц"

#: trtables.py:569 trtables.py:570
msgid "day"
msgstr "день"

#: trtables.py:574 trtables.py:575
msgid "hour"
msgstr "час"

#: trtables.py:576
msgid "minute"
msgstr "минута"

#: trtables.py:577
msgid "second"
msgstr "секунда"

#: trtables.py:588
msgid "Verification pending"
msgstr "Проверка ожидается"

#: trtables.py:589
msgid "Verification failed (e.g. missing key)"
msgstr "Проверка не удалась (например, отсутствует ключ)"

#: trtables.py:592
msgid "Good signature; Key or signature expired"
msgstr "Хорошая подпись; срок действия ключа или подписи истёк"

#: trtables.py:593
msgid "Key revoked or bad signature"
msgstr "Ключ отозван или подпись неверна"

#: trtables.py:620
#, python-brace-format
msgid "Feel free to copy the sample below and paste it into the text box. Then, click OK, and explore {menu} in the menu bar."
msgstr "Скопируйте приведённый ниже пример и вставьте его в текстовое поле. Затем нажмите ОК и изучите {menu} в строке меню."

