#: trtables.py:458
msgid "(No seal = Commit isn’t signed)"
msgstr "(Bez pečeti = commit není podepsaný)"

#: trtables.py:460
msgid "The trash keeps up to # discarded patches"
msgstr "Koš uchovává až # zahozených záplat"

#: trtables.py:461
msgid "Patches bigger than # KB won’t be salvaged"
msgstr "Záplaty větší než # kB nebudou zachráněny"

#: trtables.py:463
#, python-brace-format
msgid "When you discard changes from the working directory, {app} keeps a temporary copy in a hidden “trash” folder. This gives you a last resort to rescue changes that you have discarded by mistake. You can look around this trash folder via <i>“Help &rarr; Open Trash”</i>."
msgstr "Když zahodíte změny z pracovního adresáře, aplikace {app} uloží jejich dočasnou kopii do skryté složky „koše“. Díky tomu můžete v krajním případě zachránit změny, které jste zahodili omylem. Obsah koše můžete procházet pomocí nabídky <i>„Nápověda &rarr; Otevřít koš“</i>."

#: trtables.py:467
msgid "Logging verbosity"
msgstr "Podrobnost protokolování"

#: trtables.py:468
msgid "Auto-refresh when app regains focus"
msgstr "Automaticky aktualizovat po návratu do aplikace"

#: trtables.py:470
#, python-brace-format
msgid "When you return to {app} from another application, it automatically scans for changes in the working directory and local branches. This keeps the interface in sync with the state of your repo on disk."
msgstr "Když se do aplikace {app} vrátíte z jiné aplikace, automaticky vyhledá změny v pracovním adresáři a místních větvích. Rozhraní tak zůstane synchronizované se stavem repozitáře na disku."

#: trtables.py:473
#, python-brace-format
msgid "If you turn this off, you will need to hit {key} to perform this refresh manually."
msgstr "Pokud tuto možnost vypnete, budete muset aktualizaci spouštět ručně klávesou {key}."

#: trtables.py:475
msgid "We strongly recommend to keep this setting enabled."
msgstr "Důrazně doporučujeme ponechat toto nastavení zapnuté."

#: trtables.py:476
msgid "Auto-fetch remotes every # minutes"
msgstr "Automaticky načítat vzdálené repozitáře každých # minut"

#: trtables.py:477
msgid "Animation effects in sidebar"
msgstr "Animace v postranním panelu"

#: trtables.py:478
msgid "Smooth scrolling (where applicable)"
msgstr "Plynulé posouvání (kde je podporováno)"

#: trtables.py:479
msgid "Preferred Qt binding"
msgstr "Upřednostňovaná vazba Qt"

#: trtables.py:481
#, python-brace-format
msgid "After restarting, {app} will use this Qt binding if available."
msgstr "Po restartování použije aplikace {app} tuto vazbu Qt, bude-li dostupná."

#: trtables.py:482
msgid "You can also pass the name of a Qt binding via the “QT_API” environment variable."
msgstr "Název vazby Qt lze také předat prostřednictvím proměnné prostředí „QT_API“."

#: trtables.py:484
msgid "Use condensed fonts"
msgstr "Používat zúžená písma"

#: trtables.py:486
msgid "When a branch name or author name is too long to fit in its allotted space, condense the font before truncating the text."
msgstr "Pokud se název větve nebo jméno autora nevejde do vyhrazeného prostoru, před zkrácením textu nejprve zúžit písmo."

#: trtables.py:489
msgid "Text editor"
msgstr "Textový editor"

#: trtables.py:492 trtables.py:498 trtables.py:506
msgid "Argument placeholders:"
msgstr "Zástupné symboly argumentů:"

#: trtables.py:493
msgid "Old / Left"
msgstr "Starý / vlevo"

#: trtables.py:494
msgid "New / Right"
msgstr "Nový / vpravo"

#: trtables.py:499
msgid "Ancestor / Base / Center"
msgstr "Předek / základ / uprostřed"

#: trtables.py:500
msgid "Ours / Local / Left"
msgstr "Naše / místní / vlevo"

#: trtables.py:501
msgid "Theirs / Remote / Right"
msgstr "Jejich / vzdálené / vpravo"

#: trtables.py:502
msgid "Merged / Output / Result"
msgstr "Sloučené / výstup / výsledek"

#: trtables.py:507
msgid "Command to execute after launching the terminal"
msgstr "Příkaz spuštěný po otevření terminálu"

#: trtables.py:508
#, python-brace-format
msgid "The {0} placeholder is mandatory. It is automatically substituted for a wrapper script that enters your working directory and optionally starts one of your Custom Commands."
msgstr "Zástupný symbol {0} je povinný. Automaticky jej nahradí pomocný skript, který přejde do vašeho pracovního adresáře a volitelně spustí některý z vlastních příkazů."

#: trtables.py:513
#, python-brace-format
msgid "Have OpenSSH ask for passphrases via {app}"
msgstr "Nechat OpenSSH žádat o přístupové fráze prostřednictvím aplikace {app}"

#: trtables.py:515
#, python-brace-format
msgid "Tick this to have OpenSSH use {app} to ask for passphrases."
msgstr "Zaškrtněte, pokud má OpenSSH žádat o přístupové fráze prostřednictvím aplikace {app}."

#: trtables.py:516
#, python-brace-format
msgid "Untick this if you’ve set up another program in the {0} environment variable (such as {1})."
msgstr "Zrušte zaškrtnutí, pokud jste v proměnné prostředí {0} nastavili jiný program (například {1})."

#: trtables.py:518
msgid "(not detected)"
msgstr "(nezjištěno)"

#: trtables.py:518
msgid "Use ssh-agent provided by the system"
msgstr "Používat ssh-agent poskytovaný systémem"

#: trtables.py:519
#, python-brace-format
msgid "Have {app} manage its own ssh-agent"
msgstr "Nechat aplikaci {app} spravovat vlastní ssh-agent"

#: trtables.py:521
msgid "“ssh-agent” can save your SSH credentials so you don’t have to retype the same passphrase over and over. Some Linux distributions set up an ssh-agent for you."
msgstr "„ssh-agent“ může uložit vaše přihlašovací údaje SSH, abyste nemuseli opakovaně zadávat stejnou přístupovou frázi. Některé linuxové distribuce nastavují ssh-agent automaticky."

#: trtables.py:523
#, python-brace-format
msgid "You can also have {app} start its own instance of ssh-agent for the duration of your session and have it remember passphrases."
msgstr "Aplikace {app} může také na dobu relace spustit vlastní instanci ssh-agent a nechat ji pamatovat si přístupové fráze."

#: trtables.py:527
msgid "Parse LFS pointers"
msgstr "Zpracovávat ukazatele LFS"

#: trtables.py:529
msgid "Tick this to display the real contents from LFS files."
msgstr "Zaškrtněte, chcete-li zobrazovat skutečný obsah souborů LFS."

#: trtables.py:530
msgid "Untick to display the raw text in LFS pointers."
msgstr "Zrušte zaškrtnutí, chcete-li zobrazovat nezpracovaný text ukazatelů LFS."

#: trtables.py:533
msgid "Mouse Shortcuts"
msgstr "Zkratky myši"

#: trtables.py:534
msgid "Tip: If your mouse has side buttons, you can use them to navigate back/forward in the repo."
msgstr "Tip: Pokud má myš boční tlačítka, můžete jimi v repozitáři přecházet zpět a vpřed."

#: trtables.py:535
msgid "Repository tabs:"
msgstr "Karty repozitářů:"

#: trtables.py:536
msgid "Double-click tab"
msgstr "Dvojité kliknutí na kartu"

#: trtables.py:537
msgid "Middle-click tab"
msgstr "Kliknutí prostředním tlačítkem na kartu"

#: trtables.py:538
msgid "File lists:"
msgstr "Seznamy souborů:"

#: trtables.py:539
msgid "Double-click file"
msgstr "Dvojité kliknutí na soubor"

#: trtables.py:540
msgid "Middle-click file"
msgstr "Kliknutí prostředním tlačítkem na soubor"

#: trtables.py:541
msgid "Diff view:"
msgstr "Zobrazení porovnání:"

#: trtables.py:542
msgid "Middle-click selection"
msgstr "Kliknutí prostředním tlačítkem na výběr"

#: trtables.py:543
msgid "Stage/unstage selected lines"
msgstr "Připravit vybrané řádky / zrušit jejich přípravu"

#: trtables.py:548
msgid "Ask for confirmation before running any command"
msgstr "Před spuštěním každého příkazu žádat o potvrzení"

#: trtables.py:550
#, python-brace-format
msgid "If you untick this, you can still force a prompt to appear for specific commands by prepending them with {0}. For example: {1}"
msgstr "Pokud zaškrtnutí zrušíte, můžete si potvrzení u konkrétních příkazů přesto vynutit přidáním {0} na začátek. Příklad: {1}"

#: trtables.py:578
msgctxt "date/time formats"
msgid "Available formats:"
msgstr "Dostupné formáty:"

#: trtables.py:580 trtables.py:581
