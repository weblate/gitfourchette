msgstr "hodina"

#: trtables.py:595
msgid "minute"
msgstr "minuta"

#: trtables.py:596
msgid "second"
msgstr "sekunda"

#: trtables.py:607
msgid "Verification pending"
msgstr "Čeká se na ověření"

#: trtables.py:608
msgid "Verification failed (e.g. missing key)"
msgstr "Ověření selhalo (např. kvůli chybějícímu klíči)"

#: trtables.py:611
